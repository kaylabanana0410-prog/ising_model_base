import numpy as np
import matplotlib.pyplot as plt
from scipy.interpolate import PchipInterpolator

# =========================================================
# TIME AXIS
# =========================================================

t = np.linspace(0, 8, 5000)

# =========================================================
# MANUAL HYPNOGRAM CONTROL POINTS
# chosen to visually match the sleep-cycle figure
# =========================================================

tp = np.array([
    0.0,  0.1,  0.4,  0.7,  0.9,
    1.3,  1.55, 1.8,
    2.1,  2.5,
    3.0,  3.2,  3.7,
    3.9,  4.0,  4.1,
    4.45, 4.7,
    5.15, 5.45, 5.65, 5.9,
    6.15, 6.5,
    7.35, 7.7, 7.9, 8.0
])

Tp = np.array([
    4.0,  3.0,  2.2,  1.55, 1.55,
    2.8,  3.3,  2.7,
    1.55, 1.55,
    3.0,  4.0,  4.0,
    1.8,  4.0,  1.8,
    1.55, 1.7,
    3.3,  2.7,  3.15, 2.7,
    3.7,  3.1,
    3.45, 3.1, 2.8, 4.0
])

# =========================================================
# SMOOTH SPLINE
# MATLAB pchip equivalent
# =========================================================

pchip = PchipInterpolator(tp, Tp)
T = pchip(t)

# =========================================================
# COLORS
# =========================================================

bg = np.array([5, 10, 20]) / 255

awake_c = np.array([230, 150, 70]) / 255
rem_c   = np.array([220, 80, 80]) / 255
n1_c    = np.array([110, 180, 255]) / 255
n2_c    = np.array([70, 120, 220]) / 255
n3_c    = np.array([25, 80, 180]) / 255

# =========================================================
# FIGURE
# =========================================================

fig, ax = plt.subplots(figsize=(14, 6.5), facecolor=bg)
ax.set_facecolor(bg)

ax.tick_params(colors=[0.8, 0.8, 0.8], labelsize=14)

# =========================================================
# BACKGROUND BANDS
# =========================================================

ax.fill_between([0, 8], 3.8, 4.2, color=awake_c, alpha=0.12, edgecolor="none")
ax.fill_between([0, 8], 3.1, 3.5, color=rem_c,   alpha=0.12, edgecolor="none")
ax.fill_between([0, 8], 2.6, 3.0, color=n1_c,    alpha=0.10, edgecolor="none")
ax.fill_between([0, 8], 2.0, 2.4, color=n2_c,    alpha=0.10, edgecolor="none")
ax.fill_between([0, 8], 1.4, 1.8, color=n3_c,    alpha=0.10, edgecolor="none")

# =========================================================
# PLOT COLORED CURVE BY STATE
# =========================================================

for i in range(len(t) - 1):

    if T[i] >= 3.8:
        c = awake_c
    elif T[i] >= 3.1:
        c = rem_c
    elif T[i] >= 2.6:
        c = n1_c
    elif T[i] >= 2.0:
        c = n2_c
    else:
        c = n3_c

    ax.plot(t[i:i+2], T[i:i+2], color=c, linewidth=3)

# =========================================================
# LABELS
# =========================================================

ax.text(1.6, 3.42, "REM$_1$", color=[1, 0.7, 0.7], fontweight="bold")
ax.text(3.32, 3.42, "REM$_2$", color=[1, 0.7, 0.7], fontweight="bold")
ax.text(5.25, 3.42, "REM$_3$", color=[1, 0.7, 0.7], fontweight="bold")
ax.text(6.42, 3.42, "REM$_4$", color=[1, 0.7, 0.7], fontweight="bold")

ax.text(0.52, 1.67, "N3-4", color=[0.7, 0.8, 1], fontweight="bold")
ax.text(2.2, 1.67, "N3-4", color=[0.7, 0.8, 1], fontweight="bold")
ax.text(4.5, 1.67, "N3-4", color=[0.7, 0.8, 1], fontweight="bold")

# =========================================================
# ANNOTATION
# =========================================================

ax.annotate(
    "Brief Awakening",
    xy=(4.0, 4.0),          # arrow points here
    xytext=(4.45, 4.35),    # text position
    color=[1, 0.8, 0.3],
    fontsize=14,
    arrowprops=dict(
        arrowstyle="->",
        color=[1, 0.8, 0.3],
        linewidth=1.5
    )
)

# =========================================================
# AXES
# =========================================================

ax.set_xlim(0, 8)
ax.set_ylim(1.3, 4.5)

ax.set_xticks(np.arange(0, 9, 1))
ax.set_xticklabels([f"{i}h" for i in range(9)])

ax.set_yticks([1.6, 2.2, 2.8, 3.3, 4.0])
ax.set_yticklabels([
    "N-REM 3-4",
    "N-REM 2",
    "N-REM 1",
    "REM",
    "Awake"
])

ax.set_xlabel(
    "Time (hours)",
    color=[0.9, 0.9, 0.9],
    fontsize=16
)

ax.set_ylabel(
    "T(t) — Neural Temperature",
    color=[0.9, 0.9, 0.9],
    fontsize=16
)

ax.set_title(
    "T(t) — Effective Neural Temperature matching Sleep Hypnogram",
    color=[0.95, 0.95, 0.95],
    fontsize=22,
    fontweight="bold"
)

ax.grid(True, which="major", alpha=0.35)
ax.minorticks_on()
ax.grid(True, which="minor", alpha=0.15)

# =========================================================
# LEGEND
# =========================================================

p1, = ax.plot([], [], color=awake_c, linewidth=8)
p2, = ax.plot([], [], color=rem_c, linewidth=8)
p3, = ax.plot([], [], color=n1_c, linewidth=8)
p4, = ax.plot([], [], color=n2_c, linewidth=8)
p5, = ax.plot([], [], color=n3_c, linewidth=8)

legend = ax.legend(
    [p1, p2, p3, p4, p5],
    [
        "Awake     T = 4.0",
        "REM       T = 3.3",
        "N-REM 1   T = 2.8",
        "N-REM 2   T = 2.2",
        "N-REM 3-4 T = 1.6"
    ],
    loc="lower right",
    facecolor=[0.08, 0.12, 0.18],
    edgecolor=[0.3, 0.3, 0.3],
    framealpha=1
)

for text in legend.get_texts():
    text.set_color([0.95, 0.95, 0.95])

plt.tight_layout()
plt.show()